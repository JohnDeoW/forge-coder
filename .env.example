LLM_API_KEY=your-api-key
LLM_BASE_URL=https://your-base-url
# 模型可写成逗号分隔的列表，表示可选范围，第一个为默认；会话中可在面板输入框底部或 CLI /model 切换
LLM_MODEL_ID=your-model-id,another-model-id

# 可选：子 Agent（Explorer / Tester / Reviewer / Memory）与辅助 Agent 的模型（同样可写列表，第一个为默认），
# 各角色的具体选择在面板设置或 CLI /model 中切换；地址与密钥沿用上面的配置；未设置时使用 LLM_MODEL_ID
LLM_SUBAGENT_MODEL_ID=your-subagent-model-id,your-model-id

# 可选：主 Agent 历史压缩。历史 token 超过上下文窗口的该比例时自动生成摘要压缩（默认 0.8），保留最近几轮完整对话（默认 2）
# FORGE_COMPACT_THRESHOLD=0.8
# FORGE_COMPACT_KEEP_ROUNDS=2
# 可选：单轮 token 预算（主 Agent、子 Agent 与辅助 Agent 合计），超出后本轮停止；不设置表示不限制
# FORGE_ROUND_TOKEN_LIMIT=300000
