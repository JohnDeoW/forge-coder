LLM_API_KEY=your-api-key
LLM_BASE_URL=https://your-base-url
LLM_MODEL_ID=your-model-id

# 可选：子 Agent（Explorer / Tester）使用的模型，地址与密钥沿用上面的配置；未设置时使用 LLM_MODEL_ID
LLM_SUBAGENT_MODEL_ID=your-subagent-model-id
# 可选：单独指定某个子 Agent 的模型，优先于 LLM_SUBAGENT_MODEL_ID
# LLM_EXPLORER_MODEL_ID=
# LLM_TESTER_MODEL_ID=
# LLM_REVIEWER_MODEL_ID=
# 可选：程序级辅助 Agent（auto 模式审批等）的模型，未设置时同子 Agent
# LLM_UTILITY_MODEL_ID=
